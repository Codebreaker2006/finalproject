// Prisma schema for the fitness tracker.
// Uses Postgres because Vercel's serverless functions have no durable local
// disk — a SQLite file would be wiped between invocations. Any Postgres
// works (Vercel Postgres, Neon, Supabase, Railway...); set DATABASE_URL.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// Account credentials. Mirrors nothing in fitness.h — this is purely for
// login, kept separate from the fitness Profile model below.
model User {
  id           String   @id @default(cuid())
  email        String   @unique
  passwordHash String
  createdAt    DateTime @default(now())
  profile      Profile?
}

// Mirrors the data fields on the C++ `User` class in fitness.h/.cpp:
// sex, activity level, meal type, exercise category, unit system,
// height unit, weight unit, weight and height. This is the row that
// User::serialize() / User::deserialize() in native/fitness.cpp describes.
model Profile {
  id                String   @id @default(cuid())
  userId            String   @unique
  user              User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  sex               String // "male" | "female"
  activityLevel     String // "Sedentary" | "light" | "moderate" | "active" | "veryactive"
  mealType          String // "breakfast" | "lunch" | "dinner" | "snack"
  exerciseCategory  String // "cardio" | "strength" | "flexibility" | "sports"
  unitSystem        String // "Metric" | "Imperial"
  heightUnit        String // "meter" | "ftin"
  weightUnit        String // "kg" | "lbs"

  // Always stored in metric base units (kg, meters) regardless of the
  // user's preferred display unit, same convention the C++ main() used
  // before converting for display.
  weightKg          Float
  heightM           Float

  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
}
