# Postgres connection string. Any Postgres works: Vercel Postgres, Neon,
# Supabase, Railway, etc. On Vercel, set this in Project Settings > Environment Variables.
DATABASE_URL="postgresql://user:password@host:5432/dbname?sslmode=require"

# Random secret used to sign session cookies. Generate one with:
#   openssl rand -base64 32
SESSION_SECRET="replace-with-a-long-random-string"
